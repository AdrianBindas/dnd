		{"id":"db1030987b980c5f","type":"group","x":2900,"y":110,"width":660,"height":400,"label":"Jadro"},
		{"id":"8771b421b549b4fc","type":"text","text":"Biely les\n- priehľadné stromy\n- nie je nebezpečný","x":1920,"y":188,"width":280,"height":209},
		{"id":"51aa773420c2cf0a","type":"text","text":"???","x":-1172,"y":312,"width":123,"height":64},
		{"id":"16e6f5f0ce6a149b","type":"text","text":"Náreky stratených\n- zápach hniloby a rozkladu\n- kopa mŕtvych tiel (hlavne elfovia)\n- pod nohami sa hýbe čosi obrovské\n- z času na čas počuť náreky z dier po červovi","x":-1933,"y":-375,"width":425,"height":215},
		{"id":"784d18c85f776b43","type":"text","text":"Kraj sveta\n- útes tiel a kostených výbežkov","x":-1880,"y":-20,"width":320,"height":120},
		{"id":"4badc747e6a5edc2","type":"text","text":"Chalupa na kraji sveta\n- kenku necromancerka","x":-1895,"y":290,"width":350,"height":108},
		{"id":"b01dedd485c5f389","type":"text","text":"Svätyňa Morovému kráľovi\n- veža vytvorená z kostí a hrubej kože červa","x":-1280,"y":-330,"width":340,"height":120},
		{"id":"25bce2ee7d28d1c1","type":"text","text":"Gildore\n","x":3200,"y":164,"width":250,"height":260},
		{"id":"4532a32442bf3cb4","type":"text","text":"Osada\n- niektorí nazývajú Novým Gildorom\n- 40 elfov, halflingov a tabaxi\n- Pramatka\n- Aldric - historik","x":2273,"y":76,"width":395,"height":434},
		{"id":"a537a8b46d82c0b7","type":"text","text":"Svätyňa Pani\n- malá nepoškvrnená záhrada plná rastlín a malých zvierat\n- fontána so sochou Pani v strede\n","x":2310,"y":579,"width":320,"height":318},
		{"id":"3b218aa0f927cda1","type":"text","text":"Chrbtica\n- chrbtica niečoho dávno mŕtveho visí vysoko nad osadou a lesom\n","x":2345,"y":-209,"width":250,"height":229},
		{"id":"8ef6c0af1274b031","type":"text","text":"Mäsožravý háj\n- papraď, mach, prepadliny, jelene\n","x":1478,"y":175,"width":377,"height":236},
		{"id":"24b3d46ac2cccc08","type":"text","text":"Padnutá veža\n- horné poschodia rozpadané\n- v strede stará ale udržiavaná svätyňa\n- obývané fanatikmi ","x":1488,"y":-281,"width":392,"height":387},
		{"id":"4fa76cd0077dd5be","type":"text","text":"Membrána\n- žltá priehľadná stena ktorá sa tiahne od zeme po strop","x":2720,"y":234,"width":320,"height":118},
		{"id":"ed300b57a115ac2f","type":"text","text":"Jazero žlču\n- žlto zelená žiariacia kvapalina\n- v okolí veľká horúčava\n- v strede jazera malý ostrovček, ","x":1305,"y":509,"width":390,"height":307},
		{"id":"e17cd48a570ba764","type":"text","text":" Tábor\n- neďaleko je ústie rieky\n- drevený prístrešok schovaný za veľkým lalokom\n- Elaith\n\t- apatická, vie viac než sa zdá\n- Kurt\n\t- mrzák, zaľúbený do Elaith ale nechce aby viac trpela vinou\n- Ludo","x":-480,"y":-432,"width":320,"height":329},
		{"id":"b9d3596b5be73ef9","type":"text","text":"Stena Pani\n- hrubá sila nie je efektívna a privolá čističa","x":-838,"y":-325,"width":275,"height":115},
		{"id":"3cb7a630566e6381","type":"text","text":"Ústie\n- lietajúce tvory so 4 krídlami\n- opice, ktoré sa pokúsia niečo ukradnúť DC 10\n- diera ma antimagické pole","x":700,"y":-464,"width":290,"height":389},
		{"id":"a32c619816725456","type":"text","text":"Kostnica\n- svätyňa Pani vyrezaná do kosti, neďaleko od rieky\n- rieka sa neďaleko vodopádom vlieva do hlbín\n- pozostatky jej najvernejších","x":895,"y":-16,"width":305,"height":337},
		{"id":"c61e954904437555","type":"text","text":"Prales\n- nízky vrh, z ktorého je rozhľad po dutine\n- strop je prepletený uzlinami, ktoré obývajú opice\n","x":105,"y":-367,"width":296,"height":200},
		{"id":"421503129cf7dcb8","type":"text","text":"Starý tábor\n- kamenná pevnosť v ruinách na brehu rieky\n- kvetiny Rozkvetu tých čo sa vzdali Urielovi (pred pár mesiacmi)","x":76,"y":-16,"width":355,"height":196},
		{"id":"439061726cc2e1fd","type":"text","text":"Rieka žlču\n- žlto zelená žiariacia kvapalina ktorá nesie odpad, asi 10 metrov široká\n- obývajú ju veľké trilobity a teritoriálne mnohonôžky\n- na stenách rastú huby a popri brehu vysoká slizká tráva","x":80,"y":321,"width":347,"height":312}
	],
